# ========================================================
# Student Registration Portal - Environment Variables Template
# Copy this file to .env and populate with your credentials.
# DO NOT commit real secrets or passwords to Git.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_portal
# Set DB_SSL=true if your cloud MySQL provider requires SSL (e.g. AWS RDS, PlanetScale, Aiven, Azure)
DB_SSL=false

# Session Secret (Use a strong, cryptographically random secret in production)
SESSION_SECRET=

# Initial Development / Production Admin Credentials
ADMIN_EMAIL=admin@portal.com
ADMIN_PASSWORD=

# Frontend URL (For separate frontend deployment or cross-origin access)
FRONTEND_URL=http://localhost:3000
